# Copy this file to .env and fill in your own Hostinger SSH details.
# Find them in hPanel under Advanced -> SSH Access.
SSH_HOST=your.server.ip
SSH_PORT=65002
SSH_USER=u000000000
SSH_PASSWORD='your-password-here'

# The domain you are deploying to and its document root on the server
DOMAIN=yourdomain.com
REMOTE_PATH=domains/yourdomain.com/public_html
